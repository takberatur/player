{
  "apps": [
    {
      "name": "forge-player-liv",
      "script": "artisan",
      "args": [
        "inertia:start-ssr"
      ],
      "instances": "1",
      "wait_ready": true,
      "autorestart": true,
      "max_restarts": 10,
      "interpreter": "php",
      "watch": false,
      "error_file": "./storage/logs/pm2/err.log",
      "out_file": "./storage/logs/pm2/out.log",
      "log_file": "./storage/logs/pm2/combined.log",
      "merge_logs": true,
      "time": true,
      "env": {
        "APP_ENV": "production",
        "SSR_PORT": "13714"
      }
    }
  ]
}
